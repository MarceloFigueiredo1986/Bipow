<h3 style="font-size:@_fontSizeStyle;" class="navitem @ActiveClass" @onclick="@OnClicked">@Menu.Value</h3>

@code {
    [Parameter]
    public KeyValuePair<int,string> Menu { get; set; }

    [Parameter]
    public EventCallback<int?> ActiveChanged { get; set; }

    [Parameter]
    public int? Active { get; set; }

    string ActiveClass => Active == Menu.Key ? "active" : string.Empty;

    [Parameter]
    public int? FontSize { get; set; } = 16;

    string _fontSizeStyle => $"{FontSize}pt";

    async Task OnClicked()
    {
        Active = Menu.Key;
        await ActiveChanged.InvokeAsync(Active);
    }
}
