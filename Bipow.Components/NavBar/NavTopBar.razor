<div class="infinityHorizontalBar">
    <div style="width:@width">
        @{
            if(Menus is not null)
            {
                foreach (var menu in Menus)
                {
                    <NavItem Menu="@menu" @bind-Active="@_activeMenu" FontSize="FontSize" />
                }
            }
        }
    </div>
</div>

@code{
    [Parameter]
    public int? ActiveMenu { get; set; }

    [Parameter]
    public int? FontSize { get; set; } = 16;

    string width = string.Empty;

    int? _activeMenu
    {
        get
        {
            return ActiveMenu;
        }
        set
        {
            ActiveMenu = value;
            ActiveMenuChanged.InvokeAsync(ActiveMenu);
        }
    }

    [Parameter]
    public EventCallback<int?> ActiveMenuChanged { get; set; }

    [Parameter]
    public Dictionary<int, string>? Menus { get; set; }

    protected override void OnParametersSet()
    {
        if (Menus is not null && string.IsNullOrEmpty(width))
            width = $"{(Menus.SelectMany(a => a.Value).Count() * 17)}px;";
    }
}